# Jullius Scan — Production Environment Variables
# Copy this file to .env and fill in real values before deploying.

# ── Image version ────────────────────────────────────────────
IMAGE_TAG=latest

# ── API host (Traefik routing) ───────────────────────────────
API_HOST=jullius-api.skadi.digital

# ── Database ─────────────────────────────────────────────────
# Shared PostgreSQL on proxy-net (hostname: postgres_shared)
DATABASE_URL=postgres://jullius:CHANGE_ME@postgres_shared:5432/jullius?sslmode=disable

# ── Redis ────────────────────────────────────────────────────
# Manually provisioned Redis container on proxy-net
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Firebase ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: paste the full JSON of a Firebase service account on a single line
# (escape internal newlines as \n). Leave empty to run in stateless verification
# mode — the API still validates ID tokens via Google's public keys.
FIREBASE_CREDENTIALS_JSON=

# ── Scraper (worker only) ───────────────────────────────────
SCRAPE_TIMEOUT_SECONDS=45
MAX_RETRIES=3
WORKER_POOL_SIZE=1
